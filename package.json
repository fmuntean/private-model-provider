{
  "name": "private-model-provider",
  "displayName": "MFD: Private Model Provider",
  "description": "VS Code extension to connect to private or local LLM inference servers (Ollama, llama.cpp, LocalAI, LM Studio, vLLM) via OpenAI API compatible endpoints.",
  "version": "1.2.4",
  "publisher": "mfd",
  "icon": "assets/private-model-provider.png",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fmuntean/private-model-provider.git"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "files": [
    "out",
    "PromptTemplates",
    "assets",
    "src/ui/assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=es2020",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "test-compile": "tsc -p ./",
    "prepackage": "npm version patch --no-git-tag-version",
    "deploy": "vsce publish --no-yarn",
    "package": "vsce package --no-yarn"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Chat"
  ],
  "keywords": [
    "llm",
    "openai",
    "openai-compatible",
    "chat completions",
    "vllm",
    "ollama",
    "llama.cpp",
    "localai",
    "lm-studio",
    "lmstudio",
    "self-hosted",
    "local",
    "function calling",
    "tool calling",
    "model provider",
    "gateway"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "private-model-provider",
        "displayName": "Private Model Provider"
      }
    ],
    "commands": [
      {
        "command": "private-model-provider.setApiKey",
        "title": "Set API Key (Secure)",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.showStatus",
        "title": "Show Server Status",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.selectModel",
        "title": "View Models & Set Default",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.switchServer",
        "title": "Switch Server Preset",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.selectMcpTools",
        "title": "Select MCP Tools",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.showStats",
        "title": "View Usage Statistics",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.refreshModels",
        "title": "Refresh Model Cache",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.testConnection",
        "title": "Test Connection",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.createSession",
        "title": "Create New Session",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.switchSession",
        "title": "Switch to Session",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.generateSystemPrompts",
        "title": "Generate System Prompts",
        "category": "Private Model Provider"
      },
      {
        "command": "private-model-provider.deleteSession",
        "title": "Delete Session",
        "category": "Private Model Provider"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localModelProvider",
          "title": "Private Model",
          "icon": "assets/private-model-provider.png",
          "location": "secondarySideBar"
        }
      ]
    },
    "views": {
      "localModelProvider": [
        {
          "id": "localModelProvider.chat",
          "name": "LMP",
          "type": "webview",
          "icon": "assets/private-model-provider.png"
        }
      ]
    },
    "configuration": {
      "title": "Private Model Provider",
      "properties": {
        "private.model.provider.serverUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Inference server URL (OpenAI API compatible endpoint)",
          "order": 1
        },
        "private.model.provider.serverPresets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Preset display name"
              },
              "url": {
                "type": "string",
                "description": "Server URL"
              }
            },
            "required": [
              "name",
              "url"
            ]
          },
          "description": "Saved server presets for quick switching",
          "order": 2
        },
        "private.model.provider.defaultModel": {
          "type": "string",
          "default": "",
          "description": "Default model ID to use (leave empty for auto-select)",
          "order": 3
        },
        "private.model.provider.mcpServers": {
          "type": "array",
          "default": [],
          "description": "MCP server configurations for tool extensibility.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Human readable server name"
              },
              "command": {
                "type": "string",
                "description": "Executable command to launch the server"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the command"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "sse",
                  "http"
                ],
                "description": "Transport type"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment variables"
              }
            },
            "required": [
              "name",
              "command"
            ]
          },
          "order": 10
        },
        "private.model.provider.enabledMcpTools": {
          "type": "array",
          "default": [],
          "description": "List of enabled MCP tool names. Only these tools will be sent to the model for tool calling.",
          "items": {
            "type": "string"
          },
          "order": 11
        },
        "private.model.provider.smallModel": {
          "type": "string",
          "default": "",
          "description": "Small model ID for summarization and title generation tasks (leave empty to use default model)",
          "order": 4
        },
        "private.model.provider.requestTimeout": {
          "type": "number",
          "default": 60000,
          "description": "Request timeout in milliseconds",
          "order": 5
        },
        "private.model.provider.defaultMaxTokens": {
          "type": "number",
          "default": 32768,
          "description": "Default maximum input tokens for models (context window)",
          "order": 6
        },
        "private.model.provider.defaultMaxOutputTokens": {
          "type": "number",
          "default": 4096,
          "description": "Default maximum output tokens for models",
          "order": 7
        },
        "private.model.provider.enableToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "Enable tool calling capability for models",
          "order": 8
        },
        "private.model.provider.parallelToolCalling": {
          "type": "boolean",
          "default": true,
          "description": "Allow model to call multiple tools in parallel (disable if model has issues with parallel calls)",
          "order": 9
        },
        "private.model.provider.agentTemperature": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature for agent/tool calling mode (lower = more consistent tool call formatting). Set to 0.0 for best results with fine-tuned models.",
          "order": 10
        },
        "private.model.provider.topP": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "Top-p (nucleus) sampling parameter. Lower values make output more focused.",
          "order": 11
        },
        "private.model.provider.frequencyPenalty": {
          "type": "number",
          "default": 0,
          "minimum": -2,
          "maximum": 2,
          "description": "Frequency penalty to reduce repetition of token sequences.",
          "order": 12
        },
        "private.model.provider.presencePenalty": {
          "type": "number",
          "default": 0,
          "minimum": -2,
          "maximum": 2,
          "description": "Presence penalty to encourage talking about new topics.",
          "order": 13
        },
        "private.model.provider.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of retry attempts for failed requests.",
          "order": 15
        },
        "private.model.provider.retryDelayMs": {
          "type": "number",
          "default": 1000,
          "minimum": 100,
          "maximum": 30000,
          "description": "Base delay in milliseconds between retry attempts (uses exponential backoff).",
          "order": 16
        },
        "private.model.provider.modelCacheTtlMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "maximum": 3600000,
          "description": "How long to cache the model list in milliseconds (0 = no caching, default = 5 minutes).",
          "order": 17
        },
        "private.model.provider.logLevel": {
          "type": "string",
          "default": "warn",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "enumDescriptions": [
            "Log all messages including debug information",
            "Log informational messages, warnings, and errors",
            "Log only warnings and errors",
            "Log only errors"
          ],
          "description": "Logging verbosity level for the output channel.",
          "order": 18
        }
      },
      "private.model.provider.availableMcpTools": {
        "type": "array",
        "default": [],
        "description": "List of MCP tool names that can be enabled/disabled via the UI.",
        "items": {
          "type": "string"
        },
        "order": 4
      }
    }
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.1",
    "glob": "^13.0.6",
    "typescript": "^5.7.2",
    "commander": "^12.1.0"
  }
}
